{
  "name": "@yasnikoff/docdog",
  "version": "0.4.0",
  "description": "Context management toolkit for AI agents — disk-canonical, MCP-native",
  "type": "module",
  "bin": {
    "docdog": "./dist/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yasnikoff/docdog"
  },
  "homepage": "https://github.com/yasnikoff/docdog#readme",
  "bugs": {
    "url": "https://github.com/yasnikoff/docdog/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "templates/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "cli": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/server.ts"
  },
  "keywords": [
    "documentation",
    "ai-native",
    "sqlite",
    "graph",
    "mcp",
    "cli",
    "toolkit"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.4.0",
    "@modelcontextprotocol/sdk": "^1.10.1",
    "better-sqlite3": "^12.11.1",
    "commander": "^13.1.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.7.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.15.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
